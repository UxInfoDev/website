# ──────────────────────────────────────────────────────────────
# UX Infotech – Environment Variables Reference
# Copy this file to .env and fill in the real values.
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────────────────────

# ── Frontend (Vite) ────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000
VITE_BACKEND_URL=http://localhost:5000/api
VITE_APP_NAME=UX Infotech
VITE_CONTACT_EMAIL=hello@uxinfotech.com

# Cloudflare Turnstile (public site key — safe to expose)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# ── Backend (server-side only — NEVER use VITE_ prefix) ────────
# PostgreSQL / Supabase connection string (required)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Admin credentials stored server-side (required)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_to_a_strong_password

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters (required)
JWT_SECRET=replace_with_a_long_random_secret_string

# Cloudflare Turnstile secret key (server-side validation)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Allowed CORS origin (production domain)
# For local dev, omit or set to http://localhost:5173
CORS_ORIGIN=https://yourdomain.com

# Optional: canonical site URL for sitemap generation
BASE_URL=https://yourdomain.com

# Google Maps API key (optional)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Node environment
NODE_ENV=production
